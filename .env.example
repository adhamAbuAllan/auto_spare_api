APP_UPDATE_MIN_ANDROID_BUILD=
APP_UPDATE_LATEST_IOS_VERSION=
APP_UPDATE_LATEST_IOS_BUILD=
APP_UPDATE_MIN_IOS_VERSION=
APP_UPDATE_MIN_IOS_BUILD=
APP_UPDATE_MESSAGE=
