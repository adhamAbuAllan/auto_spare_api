# App updates: the backend reads the latest published version from both stores.
# The APP_UPDATE_LATEST_* values are only fallbacks if a store lookup fails.
# Minimum versions/builds remain manual: they decide when an update is mandatory.
# Leave APP_UPDATE_MESSAGE empty so the app shows its built-in localized prompt.
APP_UPDATE_STORE_SYNC_ENABLED=True
APP_UPDATE_STORE_CACHE_SECONDS=172800
APP_UPDATE_STORE_TIMEOUT_SECONDS=5
APP_UPDATE_ANDROID_PACKAGE_NAME=com.mta_spare_auto
APP_UPDATE_ANDROID_STORE_LANGUAGE=en
APP_UPDATE_ANDROID_STORE_COUNTRY=US
APP_UPDATE_IOS_APP_ID=6776418788
APP_UPDATE_IOS_STORE_COUNTRY=US
APP_UPDATE_LATEST_ANDROID_VERSION=
APP_UPDATE_LATEST_ANDROID_BUILD=
